{
  "publisher": "sitewhiz",
  "name": "live-collaboration",
  "displayName": "Live Collaboration",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
  "commands": [
    {
      "command": "collab.setUser",
      "title": "Set User ID & Name"
    },
    {
      "command": "collab.myProfile",
      "title": "My Collab Profile"
    },
    {
      "command": "collab.resetUser",
      "title": "Reset User ID"
    },
    {
      "command": "collab.startSession",
      "title": "Start Collab Session"
    },
    {
      "command": "collab.joinSession",
      "title": "Join Collab Session"
    },
    {
      "command": "collab.stopSession",
      "title": "Stop Collab Session"
    }
  ]
  },
  "activationEvents": [
    "onCommand:collab.setUser",
    "onCommand:collab.myProfile",
    "onCommand:collab.resetUser",
    "onCommand:collab.startSession",
    "onCommand:collab.joinSession",
    "onCommand:collab.stopSession"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3"
  }
}
